# Copy to .env.local and fill in. Never commit values. See docs/secrets.md.

# Public: shipped to the browser. Only names starting with NEXT_PUBLIC_ may go here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: never prefix these with NEXT_PUBLIC_, and read them only through src/env/server.ts.
SUPABASE_SERVICE_ROLE_KEY=
