{
  "name": "@nookbud/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "web",
    "sourceRoot": "apps/web/src",
    "targets": {
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "next dev --port 3000",
          "cwd": "apps/web"
        }
      },
      "check-secrets": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node scripts/check-client-bundle.mjs",
          "cwd": "apps/web"
        }
      },
      "container-smoke": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash ../../infra/container-smoke.sh web",
          "cwd": "apps/web"
        }
      }
    }
  },
  "dependencies": {
    "@shikijs/rehype": "^4.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "~16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
